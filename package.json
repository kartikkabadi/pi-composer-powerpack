{
  "name": "pi-composer-powerpack",
  "version": "0.1.0",
  "private": false,
  "description": "Cursor Composer 2.5 and multi-agent workflow extensions for Pi.",
  "license": "MIT",
  "type": "module",
  "pi": {
    "extensions": [
      "./extensions/cursor-sdk.ts",
      "./extensions/damage-control-continue.ts",
      "./extensions/subagent-widget.ts",
      "./extensions/coms.ts",
      "./extensions/agent-chain.ts",
      "./extensions/agent-team.ts",
      "./extensions/pi-pi.ts"
    ],
    "themes": [
      "./themes"
    ]
  },
  "files": [
    "agents",
    "config",
    "extensions",
    "themes",
    "README.md",
    "LICENSE"
  ],
  "dependencies": {
    "pi-cursor-sdk": "0.1.16",
    "yaml": "2.9.0"
  },
  "overrides": {
    "sqlite3": "6.0.1",
    "tar": "7.5.11",
    "undici": "7.25.0"
  },
  "pnpm": {
    "overrides": {
      "sqlite3": "6.0.1",
      "tar": "7.5.11",
      "undici": "7.25.0"
    }
  },
  "scripts": {
    "check:secrets": "bash -lc '! rg -n \"(api[_-]?key|token|secret|password|bearer|sk-)\\\\s*[:=]\" . --glob \"!package-lock.json\" --glob \"!pnpm-lock.yaml\" --glob \"!node_modules\"'",
    "pack:dry": "npm pack --dry-run --ignore-scripts"
  }
}
